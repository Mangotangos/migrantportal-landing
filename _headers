/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://static.cloudflareinsights.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://migrant-portal-production-3826.up.railway.app https://emailoctopus.com https://www.google-analytics.com https://www.googletagmanager.com https://region1.google-analytics.com https://www.google.com https://nominatim.openstreetmap.org https://api.zippopotam.us; img-src 'self' data: https:; frame-src 'self' https://www.google.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'
  Cache-Control: public, max-age=3600, must-revalidate

/admin
  Cache-Control: no-cache

/admin.html
  Cache-Control: no-cache

/*.css
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

